<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Admin Cursos</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <header class="admin-header">
    <div>
      <h1>Admin Cursos</h1>
      <p>Panel simple para gestionar cursos</p>
    </div>

    <div>
      <a href="/" class="btn-secundario">Ver sitio</a>
      <a href="/admin/cursos/crear" class="btn-admin">+ Nuevo curso</a>
    </div>
  </header>

  <main class="contenedor">

    <table class="tabla">
      <thead>
        <tr>
          <th>ID</th>
          <th>Título</th>
          <th>Categoría</th>
          <th>Duración</th>
          <th>Modalidad</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>

      <tbody>
        <% cursos.forEach(curso => { %>
          <tr>
            <td><%= curso.id %></td>
            <td><%= curso.titulo %></td>
            <td><%= curso.categoria %></td>
            <td><%= curso.duracion %></td>
            <td><%= curso.modalidad %></td>
            <td>
              <% if (curso.estado == 1) { %>
                Activo
              <% } else { %>
                Inactivo
              <% } %>
            </td>
            <td class="acciones">
              <a href="/admin/cursos/editar/<%= curso.id %>" class="btn-editar">Editar</a>

              <form action="/admin/cursos/eliminar/<%= curso.id %>" method="POST">
                <button type="submit" class="btn-eliminar">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  </main>

</body>
</html>