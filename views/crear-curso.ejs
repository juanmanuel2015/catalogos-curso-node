<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Crear Curso</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <header class="admin-header">
    <div>
      <h1>Crear Curso</h1>
      <p>Agregar un nuevo curso al catálogo</p>
    </div>

    <a href="/admin/cursos" class="btn-secundario">Volver</a>
  </header>

  <main class="contenedor">
    <form class="formulario" action="/admin/cursos" method="POST">

      <label>Título</label>
      <input type="text" name="titulo" required>

      <label>Descripción</label>
      <textarea name="descripcion" required></textarea>

      <label>Categoría</label>
      <input type="text" name="categoria" required>

      <label>Duración</label>
      <input type="text" name="duracion" placeholder="Ej: 40 horas" required>

      <label>Modalidad</label>
      <select name="modalidad" required>
        <option value="Online">Online</option>
        <option value="Presencial">Presencial</option>
        <option value="Mixta">Mixta</option>
      </select>

      <label>URL de imagen</label>
      <input type="text" name="imagen" required>

      <label>Estado</label>
      <select name="estado">
        <option value="1">Activo</option>
        <option value="0">Inactivo</option>
      </select>

      <button type="submit">Guardar curso</button>
    </form>
  </main>

</body>
</html>